{
	"compilerOptions": {
		"allowJs": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "./build",
		"rootDir": "./src",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": false,
		"strict": true,
		"target": "ES2022",
		"typeRoots": ["src/@types"]
	},
	"include": ["src"]
}
